# Copy this file to `.env` and fill in the values. All keys are optional —
# leaving a section blank simply disables that feature locally.

# --- Google Analytics 4 ------------------------------------------------------
# Analytics only loads in the browser after the visitor accepts cookies.
# Leave empty to disable analytics entirely (e.g. local development).
VITE_GA_MEASUREMENT_ID=

# --- Supabase ----------------------------------------------------------------
# Project URL and public anon key from: Supabase dashboard → Project Settings →
# API. The anon key is safe to expose in the browser; data access is enforced
# by Row-Level Security (see supabase/schema.sql). Powers testimonials, blog
# posts, auth and the admin dashboard. Leave empty to fall back to static data.
# (The contact form does NOT use Supabase — see EmailJS below.)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Contact form (EmailJS) ---------------------------------------------------
# Sends the contact form's email straight from the browser — no backend at
# all. Setup (~5 min, free tier): emailjs.com → sign up → Email Services →
# add one (e.g. Gmail) → note the Service ID → Email Templates → create a
# template with {{name}} {{email}} {{phone}} {{service}} {{budget}}
# {{message}} variables, "To Email" = your own inbox, "Reply To" = {{email}}
# → note the Template ID → Account → General → copy the Public Key.
#
# The public key is safe to expose (EmailJS is designed for client-side use,
# unlike Resend/SMTP keys) — but go to Account → Security → "Allowed origins"
# and restrict it to this site's domain(s) so nobody else can send through
# your account with a copied key.
#
# Leave any of these empty to disable sending locally (submissions are
# silently no-op'd, matching other unconfigured integrations in dev).
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_NOTIFY_TEMPLATE_ID=
# Optional second template (same variables, "To Email" = {{email}}) that
# auto-replies to the visitor confirming receipt. Leave empty to skip it.
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=

# Base URL used to build Supabase auth email redirect links (signup
# confirmation, magic link, password reset, email change) — see
# src/lib/authRedirect.ts. Leave empty locally: it falls back to the current
# origin (http://localhost:5173). Set in production so links always resolve
# to the real domain:
VITE_SITE_URL=https://navyaedtech.com

# --- Error reporting (Sentry) ------------------------------------------------
# DSN from: Sentry dashboard → Project → Settings → Client Keys (DSN). When set,
# warnings/errors logged via src/lib/logger.ts are forwarded to Sentry in
# production builds. Leave empty to disable reporting (the SDK is never loaded).
VITE_SENTRY_DSN=

# --- Bot protection: Cloudflare Turnstile ------------------------------------
# Public SITE key from: Cloudflare dashboard → Turnstile → add a widget. When
# set, the contact + testimonial forms render a Turnstile challenge before
# allowing submission.
#   - Testimonial form: verified server-side by the `submit` Supabase Edge
#     Function (its SECRET key is not a VITE_ var — see supabase/README.md §5).
#   - Contact form: NOT verified anywhere (EmailJS has no backend to check
#     it against) — it's just a client-side speed bump against unsophisticated
#     bots driving the real page. The main defence against someone abusing the
#     EmailJS keys directly is the "Allowed origins" restriction above.
# Leave this empty to disable the challenge (forms fall back to the direct path).
VITE_TURNSTILE_SITE_KEY=

# --- Email notifications (Resend) — testimonials only, server-side ----------
# NOT a VITE_ var — a secret set on the Supabase `submit` Edge Function, never
# exposed to the browser. Notifies the team when a new testimonial is
# submitted. See supabase/README.md §6:
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set CONTACT_FROM="Navya EdTech <hello@your-domain.com>"
#   supabase secrets set CONTACT_NOTIFY_TO=team@your-domain.com
